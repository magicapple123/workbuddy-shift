{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: only the core/plugin APIs the UI actually calls",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-is-visible",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "opener:default",
    "dialog:allow-save"
  ]
}
